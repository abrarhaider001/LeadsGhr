# LeadsGhr settings: copy this file to `.env` in the repository root and fill in what you need.
# `.env` is git-ignored and never reaches GitHub. Never put real values in this example file.

# ---------------------------------------------------------------------------------------------
# Read by LeadsGhr itself
# ---------------------------------------------------------------------------------------------

# App mode: `production` (default) requires license keys; `local` turns them off for development
# and testing. Any other value, or a missing line, counts as `production`.
#   - Desktop app: read each time `pnpm dev` starts (restart after changing it). An installed
#     app always requires a key, whatever this says.
#   - Chrome extensions: read when they are built (`pnpm build:extension`,
#     `pnpm build:mailer-extension`); rebuild and press Reload in Chrome after changing it.
#     A `local` build never replaces the extension ZIPs committed in the repository.
# Releases built from `main` on GitHub Actions are always `production`.
LEADSGHR_MODE=production

# Optional: keep the desktop app's data (database, preferences, license) in another folder
# instead of C:\LeadsGhr\data, for example for a test or performance run.
# LEADSGHR_DATA_DIR=

# Optional: check for desktop updates at another address instead of the GitHub Releases feed.
# LEADSGHR_UPDATE_URL=

# ---------------------------------------------------------------------------------------------
# Supabase and mail tracking (used by the GitHub deploy workflow and the Supabase Edge
# Functions, set as GitHub repository secrets / Supabase function secrets; keep a copy here
# only for your own reference)
# ---------------------------------------------------------------------------------------------

# The hosted project's 20-character reference (the id in the Supabase dashboard URL).
SUPABASE_PROJECT_ID=
# Personal access token from https://supabase.com/dashboard/account/tokens (deploy workflow).
SUPABASE_ACCESS_TOKEN=
# Database password of the Supabase project.
SUPABASE_PASSWORD=
# Token used for GitHub Actions access to Supabase.
SUPABASE_GITHUB_ACTIONS_TOKEN=
# Shared key that lets LeadsGhr Tracker register tracked emails with the mail-tracking function.
MAIL_TRACKING_REGISTRATION_KEY=
# Public address of the mail-tracking endpoint used in tracking images.
PUBLIC_TRACKING_URL=

# ---------------------------------------------------------------------------------------------
# Email sender (Resend), for sending email from the owner's tooling
# ---------------------------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
