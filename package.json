{
  "name": "leadsghr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "pnpm --filter @leadsghr/desktop run rebuild:native",
    "dev": "pnpm --filter @leadsghr/desktop dev",
    "dev:desktop": "pnpm --filter @leadsghr/desktop dev",
    "build:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "clear:crawl-history": "node scripts/clear-local-crawl-history.mjs",
    "build": "pnpm --filter @leadsghr/desktop build",
    "build:mailer-extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-mailer-extension.ps1",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "png-to-ico": "^3.0.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
