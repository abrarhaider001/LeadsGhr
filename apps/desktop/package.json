{
    "name": "@leadsghr/desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node ../../scripts/generate-tokens.mjs && electron-vite dev",
        "build": "node ../../scripts/generate-tokens.mjs && electron-vite build && pnpm run build:uninstall && electron-builder --publish never && node scripts/finish-web-installer.mjs && pnpm run build:setup",
        "build:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File setup/build-setup.ps1 -Target setup",
        "build:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File setup/build-setup.ps1 -Target uninstall",
        "rebuild:native": "electron-rebuild -f -o better-sqlite3",
        "typecheck": "tsc --noEmit",
        "lint": "tsc --noEmit"
    },
    "dependencies": {
        "better-sqlite3": "^12.2.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.2.1",
        "@leadsghr/app": "workspace:*",
        "@leadsghr/crawler": "workspace:*",
        "@leadsghr/export": "workspace:*",
        "@leadsghr/extract": "workspace:*",
        "@leadsghr/license": "workspace:*",
        "@leadsghr/platform": "workspace:*",
        "@leadsghr/quality": "workspace:*",
        "@leadsghr/schemas": "workspace:*",
        "@leadsghr/ui": "workspace:*",
        "@tailwindcss/vite": "^4.3.5",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "electron": "^38.0.0",
        "electron-builder": "^26.0.0",
        "electron-updater": "^6.6.0",
        "electron-vite": "^4.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "robots-parser": "^3.0.1",
        "tailwindcss": "^4.3.5",
        "undici": "^7.16.0",
        "zod": "^4.1.12"
    },
    "main": "./out/main/main.cjs"
}
